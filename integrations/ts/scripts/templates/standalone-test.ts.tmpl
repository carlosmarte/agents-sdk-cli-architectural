import { describe, expect, it } from "vitest";

import { createProvider, registeredProviders } from "@llmorch/core";

import { PROVIDER_ID } from "../src/index.js";

describe("standalone-adapter-__ID__", () => {
  it("self-registers the __ID__ provider at import", () => {
    expect(registeredProviders()).toContain("__ID__");
    expect(PROVIDER_ID).toBe("__ID__");
  });

  it("constructs a provider implementing the full LLMProvider port", () => {
    const provider = createProvider("__ID__", { apiKey: "test-key" });
    expect(provider.providerId).toBe("__ID__");
    const methods = [
      "chat",
      "stream",
      "generateStructured",
      "invokeTool",
      "resumeTool",
    ] as const;
    for (const method of methods) {
      expect(typeof provider[method]).toBe("function");
    }
  });
});
